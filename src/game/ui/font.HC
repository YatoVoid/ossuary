#define FONT_FIRST     32
#define FONT_GLYPHS    64
#define FONT_SOLID     64
#define FONT_GLYPH_W   5
#define FONT_GLYPH_H   7
#define FONT_ADVANCE   6
#define FONT_CELL      8
#define FONT_COLS      16
#define FONT_ATLAS_W   128
#define FONT_ATLAS_H   40

// 5x7 glyphs for ASCII 32-95, one byte per row, bit 4 is the left column.
// Lowercase is folded to uppercase when drawing.
U8 g_font_rows[FONT_GLYPHS * FONT_GLYPH_H] = {
  0x00,0x00,0x00,0x00,0x00,0x00,0x00, // space
  0x04,0x04,0x04,0x04,0x04,0x00,0x04, // !
  0x0A,0x0A,0x0A,0x00,0x00,0x00,0x00, // "
  0x0A,0x0A,0x1F,0x0A,0x1F,0x0A,0x0A, // #
  0x04,0x0F,0x14,0x0E,0x05,0x1E,0x04, // $
  0x18,0x19,0x02,0x04,0x08,0x13,0x03, // %
  0x0C,0x12,0x14,0x08,0x15,0x12,0x0D, // &
  0x04,0x04,0x08,0x00,0x00,0x00,0x00, // '
  0x02,0x04,0x08,0x08,0x08,0x04,0x02, // (
  0x08,0x04,0x02,0x02,0x02,0x04,0x08, // )
  0x00,0x04,0x15,0x0E,0x15,0x04,0x00, // *
  0x00,0x04,0x04,0x1F,0x04,0x04,0x00, // +
  0x00,0x00,0x00,0x00,0x0C,0x04,0x08, // ,
  0x00,0x00,0x00,0x1F,0x00,0x00,0x00, // -
  0x00,0x00,0x00,0x00,0x00,0x0C,0x0C, // .
  0x00,0x01,0x02,0x04,0x08,0x10,0x00, // /
  0x0E,0x11,0x13,0x15,0x19,0x11,0x0E, // 0
  0x04,0x0C,0x04,0x04,0x04,0x04,0x0E, // 1
  0x0E,0x11,0x01,0x02,0x04,0x08,0x1F, // 2
  0x1F,0x02,0x04,0x02,0x01,0x11,0x0E, // 3
  0x02,0x06,0x0A,0x12,0x1F,0x02,0x02, // 4
  0x1F,0x10,0x1E,0x01,0x01,0x11,0x0E, // 5
  0x06,0x08,0x10,0x1E,0x11,0x11,0x0E, // 6
  0x1F,0x01,0x02,0x04,0x08,0x08,0x08, // 7
  0x0E,0x11,0x11,0x0E,0x11,0x11,0x0E, // 8
  0x0E,0x11,0x11,0x0F,0x01,0x02,0x0C, // 9
  0x00,0x0C,0x0C,0x00,0x0C,0x0C,0x00, // :
  0x00,0x0C,0x0C,0x00,0x0C,0x04,0x08, // ;
  0x02,0x04,0x08,0x10,0x08,0x04,0x02, // <
  0x00,0x00,0x1F,0x00,0x1F,0x00,0x00, // =
  0x08,0x04,0x02,0x01,0x02,0x04,0x08, // >
  0x0E,0x11,0x01,0x02,0x04,0x00,0x04, // ?
  0x0E,0x11,0x01,0x0D,0x15,0x15,0x0E, // @
  0x0E,0x11,0x11,0x11,0x1F,0x11,0x11, // A
  0x1E,0x11,0x11,0x1E,0x11,0x11,0x1E, // B
  0x0E,0x11,0x10,0x10,0x10,0x11,0x0E, // C
  0x1C,0x12,0x11,0x11,0x11,0x12,0x1C, // D
  0x1F,0x10,0x10,0x1E,0x10,0x10,0x1F, // E
  0x1F,0x10,0x10,0x1E,0x10,0x10,0x10, // F
  0x0E,0x11,0x10,0x17,0x11,0x11,0x0F, // G
  0x11,0x11,0x11,0x1F,0x11,0x11,0x11, // H
  0x0E,0x04,0x04,0x04,0x04,0x04,0x0E, // I
  0x07,0x02,0x02,0x02,0x02,0x12,0x0C, // J
  0x11,0x12,0x14,0x18,0x14,0x12,0x11, // K
  0x10,0x10,0x10,0x10,0x10,0x10,0x1F, // L
  0x11,0x1B,0x15,0x15,0x11,0x11,0x11, // M
  0x11,0x11,0x19,0x15,0x13,0x11,0x11, // N
  0x0E,0x11,0x11,0x11,0x11,0x11,0x0E, // O
  0x1E,0x11,0x11,0x1E,0x10,0x10,0x10, // P
  0x0E,0x11,0x11,0x11,0x15,0x12,0x0D, // Q
  0x1E,0x11,0x11,0x1E,0x14,0x12,0x11, // R
  0x0F,0x10,0x10,0x0E,0x01,0x01,0x1E, // S
  0x1F,0x04,0x04,0x04,0x04,0x04,0x04, // T
  0x11,0x11,0x11,0x11,0x11,0x11,0x0E, // U
  0x11,0x11,0x11,0x0A,0x0A,0x04,0x04, // V
  0x11,0x11,0x11,0x15,0x15,0x15,0x0A, // W
  0x11,0x11,0x0A,0x04,0x0A,0x11,0x11, // X
  0x11,0x11,0x11,0x0A,0x04,0x04,0x04, // Y
  0x1F,0x01,0x02,0x04,0x08,0x10,0x1F, // Z
  0x0E,0x08,0x08,0x08,0x08,0x08,0x0E, // [
  0x00,0x10,0x08,0x04,0x02,0x01,0x00, // backslash
  0x0E,0x02,0x02,0x02,0x02,0x02,0x0E, // ]
  0x04,0x0A,0x11,0x00,0x00,0x00,0x00, // ^
  0x00,0x00,0x00,0x00,0x00,0x00,0x1F, // _
};

I64 FontGlyphIndex(U8 ch)
{
  if (ch >= 'a' && ch <= 'z')
    ch -= 32;
  if (ch < FONT_FIRST || ch >= FONT_FIRST + FONT_GLYPHS)
    ch = '?';
  return ch - FONT_FIRST;
}

U32 FontBuildAtlas(Arena *scratch)
{
  I64 mark = scratch->used;
  Image img;
  ImageInit(&img, scratch, FONT_ATLAS_W, FONT_ATLAS_H);

  for (I64 g = 0; g < FONT_GLYPHS; g++) {
    I64 ox = (g % FONT_COLS) * FONT_CELL;
    I64 oy = (g / FONT_COLS) * FONT_CELL;
    for (I64 row = 0; row < FONT_GLYPH_H; row++) {
      U8 bits = g_font_rows[g * FONT_GLYPH_H + row];
      for (I64 col = 0; col < FONT_GLYPH_W; col++)
        if (bits & (0x10 >> col))
          ImagePut(&img, ox + col, oy + row, 1.0, 1.0, 1.0, 1.0);
    }
  }

  I64 sx = (FONT_SOLID % FONT_COLS) * FONT_CELL;
  I64 sy = (FONT_SOLID / FONT_COLS) * FONT_CELL;
  for (I64 y = 0; y < FONT_CELL; y++)
    for (I64 x = 0; x < FONT_CELL; x++)
      ImagePut(&img, sx + x, sy + y, 1.0, 1.0, 1.0, 1.0);

  U32 tex = TextureUpload(&img, FALSE, FALSE);
  scratch->used = mark;
  return tex;
}
